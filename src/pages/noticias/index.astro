---
export const prerender = false;

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DIRECTUS_URL, fetchDirectus, assetUrl } from '../../lib/directus';
import '../../styles/global.css';

interface NoticiaListItem {
	id: string;
	titulo: string;
	slug: string;
	resumo: string | null;
	image: string | null;
	data_publicacao: string | null;
}

const PAGE_SIZE = 12;

const noticias = await fetchDirectus<NoticiaListItem>(
	`/items/noticias?filter[status][_eq]=published&fields=id,titulo,slug,resumo,image,data_publicacao&sort=-data_publicacao&limit=${PAGE_SIZE}`
);

// Separate count query — uses meta=filter_count for a clean number response
const totalCount = noticias.length < PAGE_SIZE ? noticias.length : await (async () => {
	try {
		const res = await fetch(
			`${DIRECTUS_URL}/items/noticias?filter[status][_eq]=published&limit=1&fields=id&meta=filter_count`,
			{ headers: import.meta.env.DIRECTUS_TOKEN ? { Authorization: `Bearer ${import.meta.env.DIRECTUS_TOKEN}` } : {} }
		);
		if (!res.ok) return noticias.length;
		const json = await res.json();
		const count = Number(json.meta?.filter_count);
		return Number.isFinite(count) && count > 0 ? count : noticias.length;
	} catch {
		return noticias.length;
	}
})();
const hasMore = totalCount > PAGE_SIZE;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Notícias e comunicação oficial da Rede Condor. Novidades, inaugurações, campanhas e ações sociais." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<title>Notícias — Condor</title>
	</head>
	<body>
		<Header />
		<main>
			<!-- Breadcrumb -->
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<div class="breadcrumb-container">
					<a href="/">Início</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<span aria-current="page">Notícias</span>
				</div>
			</nav>

			<!-- Header -->
			<section class="news-header">
				<div class="news-header-content">
					<h1 class="news-header-title">Notícias</h1>
					<p class="news-header-sub">Comunicação oficial da Rede Condor</p>
				</div>
			</section>

			<!-- Search -->
			<section class="news-search-section">
				<div class="news-search-wrap">
					<div class="news-search-input-wrap">
						<svg class="news-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="search"
							id="news-search-input"
							class="news-search-input"
							placeholder="Buscar notícias por título ou resumo..."
							aria-label="Buscar notícias"
							autocomplete="off"
						/>
						<button type="button" class="news-search-clear" id="news-search-clear" hidden aria-label="Limpar busca">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
						</button>
					</div>
					<p class="news-search-status" id="news-search-status" hidden></p>
				</div>
			</section>

			<!-- Grid -->
			<section class="news-grid-section">
				<div class="news-grid" id="news-grid">
					{noticias.map((noticia) => {
						const thumb = assetUrl(noticia.image, { width: 600, height: 400, fit: 'cover' }, '') || null;
						const dataStr = noticia.data_publicacao
							? new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', {
									day: '2-digit',
									month: 'short',
									year: 'numeric',
								})
							: null;
						return (
							<a href={`/noticias/${noticia.slug}`} class="news-card">
								<div class="news-card-img-wrap">
									{thumb ? (
										<img src={thumb} alt={noticia.titulo} class="news-card-img" width="600" height="400" loading="lazy" decoding="async" />
									) : (
										<div class="news-card-img-placeholder">
											<span>C</span>
										</div>
									)}
								</div>
								<div class="news-card-body">
									{dataStr && <time class="news-card-date">{dataStr}</time>}
									<h2 class="news-card-title">{noticia.titulo}</h2>
									{noticia.resumo && <p class="news-card-excerpt">{noticia.resumo}</p>}
								</div>
							</a>
						);
					})}
				</div>

				<!-- Empty state -->
				<div class="news-empty" id="news-empty" hidden>
					<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<p class="news-empty-title">Nenhuma notícia encontrada</p>
					<p class="news-empty-sub">Tente buscar com outras palavras.</p>
				</div>

				<!-- Load more -->
				<div class="news-load-more" id="load-more-wrap" hidden={!hasMore}>
					<button class="news-load-more-btn" id="load-more-btn" type="button">
						Ver mais notícias
					</button>
					<div class="news-load-more-spinner" id="load-more-spinner" hidden>
						<span class="spinner"></span>
					</div>
				</div>

				<!-- Sentinel for infinite scroll on mobile -->
				<div id="scroll-sentinel" aria-hidden="true"></div>
			</section>
		</main>
		<Footer />

		<!-- Client-side search + pagination script -->
		<script define:vars={{ DIRECTUS_URL, PAGE_SIZE, totalCount }}>
			(function () {
				const grid = document.getElementById('news-grid');
				const btn = document.getElementById('load-more-btn');
				const spinner = document.getElementById('load-more-spinner');
				const sentinel = document.getElementById('scroll-sentinel');
				const loadMoreWrap = document.getElementById('load-more-wrap');
				const searchInput = document.getElementById('news-search-input');
				const searchClear = document.getElementById('news-search-clear');
				const searchStatus = document.getElementById('news-search-status');
				const emptyState = document.getElementById('news-empty');

				if (!grid || !btn || !searchInput) return;

				let offset = PAGE_SIZE;
				let total = totalCount;
				let currentQuery = '';
				let loading = false;
				let searchTimer = null;
				let searchSeq = 0;

				function formatDate(dateStr) {
					if (!dateStr) return null;
					return new Date(dateStr).toLocaleDateString('pt-BR', {
						day: '2-digit',
						month: 'short',
						year: 'numeric',
					});
				}

				function escapeHtml(str) {
					if (str == null) return '';
					return String(str)
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;')
						.replace(/'/g, '&#039;');
				}

				function createCard(noticia) {
					const thumb = noticia.image
						? `${DIRECTUS_URL}/assets/${noticia.image}?width=600&height=400&fit=cover`
						: null;
					const dataStr = formatDate(noticia.data_publicacao);
					const titulo = escapeHtml(noticia.titulo);
					const resumo = noticia.resumo ? escapeHtml(noticia.resumo) : null;
					const slug = encodeURIComponent(noticia.slug);

					const card = document.createElement('a');
					card.href = `/noticias/${slug}`;
					card.className = 'news-card';

					card.innerHTML = `
						<div class="news-card-img-wrap">
							${thumb
								? `<img src="${thumb}" alt="${titulo}" class="news-card-img" width="600" height="400" loading="lazy" decoding="async" />`
								: `<div class="news-card-img-placeholder"><span>C</span></div>`
							}
						</div>
						<div class="news-card-body">
							${dataStr ? `<time class="news-card-date">${dataStr}</time>` : ''}
							<h2 class="news-card-title">${titulo}</h2>
							${resumo ? `<p class="news-card-excerpt">${resumo}</p>` : ''}
						</div>
					`;

					return card;
				}

				function buildFilter(query) {
					if (!query) return { status: { _eq: 'published' } };
					return {
						_and: [
							{ status: { _eq: 'published' } },
							{
								_or: [
									{ titulo: { _contains: query } },
									{ resumo: { _contains: query } },
								],
							},
						],
					};
				}

				function buildUrl(query, offsetValue, includeCount) {
					const params = new URLSearchParams();
					params.set('filter', JSON.stringify(buildFilter(query)));
					params.set('fields', 'id,titulo,slug,resumo,image,data_publicacao');
					params.set('sort', '-data_publicacao');
					params.set('limit', String(PAGE_SIZE));
					params.set('offset', String(offsetValue));
					if (includeCount) params.set('meta', 'filter_count');
					return `${DIRECTUS_URL}/items/noticias?${params.toString()}`;
				}

				function updateUiVisibility() {
					const hasItems = grid.children.length > 0;
					const hasMore = offset < total;

					if (emptyState) emptyState.hidden = hasItems;
					if (loadMoreWrap) loadMoreWrap.hidden = !hasItems || !hasMore;
					if (sentinel) sentinel.style.display = hasItems && hasMore ? '' : 'none';
				}

				function updateStatus(message) {
					if (!searchStatus) return;
					if (message) {
						searchStatus.textContent = message;
						searchStatus.hidden = false;
					} else {
						searchStatus.textContent = '';
						searchStatus.hidden = true;
					}
				}

				async function loadMore() {
					if (loading || offset >= total) return;
					loading = true;

					btn.hidden = true;
					spinner.hidden = false;

					try {
						const res = await fetch(buildUrl(currentQuery, offset, false));
						const json = await res.json();
						const items = json.data || [];

						for (const item of items) {
							grid.appendChild(createCard(item));
						}

						offset += items.length;
					} catch (err) {
						console.error('Error loading more news:', err);
					} finally {
						spinner.hidden = true;
						btn.hidden = false;
						loading = false;
						updateUiVisibility();
					}
				}

				async function runSearch(query) {
					const seq = ++searchSeq;
					currentQuery = query;
					loading = true;

					grid.innerHTML = '';
					spinner.hidden = false;
					btn.hidden = true;
					if (emptyState) emptyState.hidden = true;
					if (loadMoreWrap) loadMoreWrap.hidden = true;

					try {
						const res = await fetch(buildUrl(query, 0, true));
						const json = await res.json();

						// Discard stale responses
						if (seq !== searchSeq) return;

						const items = json.data || [];
						const filterCount = Number(json.meta?.filter_count);
						total = Number.isFinite(filterCount) ? filterCount : items.length;
						offset = items.length;

						for (const item of items) {
							grid.appendChild(createCard(item));
						}

						if (query) {
							updateStatus(
								total === 0
									? `Nenhum resultado para "${query}"`
									: `${total} ${total === 1 ? 'resultado' : 'resultados'} para "${query}"`
							);
						} else {
							updateStatus('');
						}
					} catch (err) {
						console.error('Error searching news:', err);
						updateStatus('Erro ao buscar. Tente novamente.');
					} finally {
						if (seq === searchSeq) {
							spinner.hidden = true;
							btn.hidden = false;
							loading = false;
							updateUiVisibility();
						}
					}
				}

				function syncUrl(query) {
					const url = new URL(window.location.href);
					if (query) url.searchParams.set('q', query);
					else url.searchParams.delete('q');
					window.history.replaceState({}, '', url);
				}

				function handleInput() {
					const value = searchInput.value.trim();
					searchClear.hidden = value.length === 0;

					clearTimeout(searchTimer);
					searchTimer = setTimeout(() => {
						syncUrl(value);
						runSearch(value);
					}, 300);
				}

				btn.addEventListener('click', loadMore);
				searchInput.addEventListener('input', handleInput);
				searchClear.addEventListener('click', () => {
					searchInput.value = '';
					searchClear.hidden = true;
					syncUrl('');
					runSearch('');
					searchInput.focus();
				});

				// Initialize from URL ?q=...
				const initialQuery = new URL(window.location.href).searchParams.get('q')?.trim() || '';
				if (initialQuery) {
					searchInput.value = initialQuery;
					searchClear.hidden = false;
					runSearch(initialQuery);
				} else {
					updateUiVisibility();
				}

				if (sentinel && 'IntersectionObserver' in window) {
					const isMobile = () => window.innerWidth < 768;
					const observer = new IntersectionObserver(
						(entries) => {
							if (entries[0].isIntersecting && isMobile()) loadMore();
						},
						{ rootMargin: '200px' }
					);
					observer.observe(sentinel);
				}
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #FFFFFF;
		--bg-surface: #F7F9FC;
		--border-subtle: #E2E8F0;
		--accent-red: #E31937;
		--accent-red-glow: #FF2D4B;
		--text-primary: #1A1A2E;
		--text-secondary: #4A5568;
		--text-muted: #718096;
	}

	/* === Breadcrumb === */
	.breadcrumb {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border-subtle);
		padding: 0.75rem 0;
	}

	.breadcrumb-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.breadcrumb-container a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb-container a:hover {
		color: var(--accent-red);
	}

	.breadcrumb-sep { color: var(--border-subtle); }

	.breadcrumb-container [aria-current="page"] {
		color: var(--text-primary);
		font-weight: 500;
	}

	/* === Header === */
	.news-header {
		background: var(--bg-primary);
		padding: 2.5rem 0 2rem;
	}

	.news-header-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	@media (min-width: 768px) {
		.news-header-content {
			padding: 0 2rem;
		}
	}

	.news-header-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 800;
		font-size: clamp(2rem, 5vw, 3rem);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--text-primary);
		margin: 0 0 0.5rem;
	}

	.news-header-title::after {
		content: '';
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent-red);
		margin-top: 0.75rem;
		border-radius: 2px;
	}

	.news-header-sub {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 1rem;
		color: var(--text-muted);
		margin: 1rem 0 0;
	}

	/* === Search === */
	.news-search-section {
		background: var(--bg-primary);
		padding: 0 0 1.5rem;
	}

	.news-search-wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	@media (min-width: 1024px) {
		.news-search-wrap {
			padding: 0 2rem;
		}
	}

	.news-search-input-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.news-search-icon {
		position: absolute;
		left: 1rem;
		color: var(--text-muted);
		pointer-events: none;
	}

	.news-search-input {
		width: 100%;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--text-primary);
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		padding: 0.85rem 3rem 0.85rem 3rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
		-webkit-appearance: none;
		appearance: none;
	}

	.news-search-input::-webkit-search-decoration,
	.news-search-input::-webkit-search-cancel-button,
	.news-search-input::-webkit-search-results-button,
	.news-search-input::-webkit-search-results-decoration {
		display: none;
	}

	.news-search-input::placeholder {
		color: var(--text-muted);
	}

	.news-search-input:focus {
		outline: none;
		border-color: var(--accent-red);
		background: var(--bg-primary);
		box-shadow: 0 0 0 3px rgba(227, 25, 55, 0.12);
	}

	.news-search-clear {
		position: absolute;
		right: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: transparent;
		border: none;
		border-radius: 50%;
		color: var(--text-muted);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.news-search-clear:hover {
		background: var(--border-subtle);
		color: var(--text-primary);
	}

	.news-search-status {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0.75rem 0 0;
	}

	/* === Empty state === */
	.news-empty {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		color: var(--text-muted);
	}

	.news-empty svg {
		color: var(--border-subtle);
		margin-bottom: 1rem;
	}

	.news-empty-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 700;
		font-size: 1.25rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		margin: 0 0 0.25rem;
	}

	.news-empty-sub {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.9rem;
		margin: 0;
	}

	/* === Grid === */
	.news-grid-section {
		background: var(--bg-primary);
		padding: 0 0 4rem;
	}

	.news-grid {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.news-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.news-grid {
			grid-template-columns: repeat(3, 1fr);
			padding: 0 2rem;
		}
	}

	/* === Card === */
	.news-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.news-card:hover {
		border-color: var(--accent-red);
		box-shadow: 0 4px 20px rgba(227, 25, 55, 0.08);
	}

	.news-card-img-wrap {
		position: relative;
		aspect-ratio: 3 / 2;
		background: var(--bg-surface);
		overflow: hidden;
	}

	.news-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.news-card:hover .news-card-img {
		transform: scale(1.03);
	}

	.news-card-img-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-surface);
	}

	.news-card-img-placeholder span {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 800;
		font-size: 3rem;
		color: var(--border-subtle);
	}

	.news-card-body {
		padding: 1.25rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.news-card-date {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--accent-red);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.5rem;
	}

	.news-card-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		line-height: 1.25;
		color: var(--text-primary);
		margin: 0 0 0.5rem;
	}

	.news-card-excerpt {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* === Load More === */
	.news-load-more {
