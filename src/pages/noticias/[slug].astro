---
export const prerender = false;

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL || 'http://localhost:8055';
const { slug } = Astro.params;

const res = await fetch(
	`${DIRECTUS_URL}/items/noticias?filter[slug][_eq]=${slug}&filter[status][_eq]=published&fields=id,titulo,slug,resumo,content,image,data_publicacao&limit=1`
);
const { data } = await res.json();

if (!data || data.length === 0) {
	return Astro.redirect('/404');
}

const noticia = data[0];
const heroImage = noticia.image
	? `${DIRECTUS_URL}/assets/${noticia.image}?width=1200&height=480&fit=cover`
	: null;
const thumbImage = noticia.image
	? `${DIRECTUS_URL}/assets/${noticia.image}?width=600&height=400&fit=cover`
	: null;

const dataPublicacao = noticia.data_publicacao
	? new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', {
			day: '2-digit',
			month: 'long',
			year: 'numeric',
		})
	: null;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{noticia.resumo && <meta name="description" content={noticia.resumo} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<title>{noticia.titulo} — Notícias Condor</title>
	</head>
	<body>
		<Header />
		<main>
			<!-- Breadcrumb -->
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<div class="breadcrumb-container">
					<a href="/">Início</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<a href="/noticias">Notícias</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<span aria-current="page">{noticia.titulo}</span>
				</div>
			</nav>

			<!-- Banner -->
			{heroImage && (
				<div class="news-banner">
					<img
						src={heroImage}
						alt={noticia.titulo}
						class="news-banner-img"
						width="1200"
						height="480"
					/>
				</div>
			)}

			<!-- Title -->
			<header class="news-header">
				<div class="news-header-content">
					{dataPublicacao && (
						<time class="news-date" datetime={noticia.data_publicacao}>
							{dataPublicacao}
						</time>
					)}
					<h1 class="news-title">{noticia.titulo}</h1>
				</div>
			</header>

			<!-- Content -->
			<article class="news-body">
				<div class="news-container" set:html={noticia.content} />
			</article>

			<!-- Back -->
			<div class="news-back">
				<a href="/noticias" class="news-back-link">
					<span aria-hidden="true">&larr;</span> Voltar para Notícias
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	:root {
		--bg-primary: #FFFFFF;
		--bg-surface: #F7F9FC;
		--border-subtle: #E2E8F0;
		--accent-red: #E31937;
		--accent-red-glow: #FF2D4B;
		--text-primary: #1A1A2E;
		--text-secondary: #4A5568;
		--text-muted: #718096;
	}

	/* === Breadcrumb === */
	.breadcrumb {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border-subtle);
		padding: 0.75rem 0;
	}

	.breadcrumb-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.breadcrumb-container a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb-container a:hover {
		color: var(--accent-red);
	}

	.breadcrumb-sep {
		color: var(--border-subtle);
	}

	.breadcrumb-container [aria-current="page"] {
		color: var(--text-primary);
		font-weight: 500;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 300px;
	}

	/* === Banner === */
	.news-banner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem 0;
	}

	@media (min-width: 768px) {
		.news-banner {
			padding: 2rem 2rem 0;
		}
	}

	.news-banner-img {
		width: 100%;
		height: auto;
		max-height: 480px;
		object-fit: cover;
		border-radius: 6px;
		display: block;
	}

	/* === Header === */
	.news-header {
		background: var(--bg-primary);
		padding: 2rem 0 0;
	}

	.news-header-content {
		max-width: 780px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	@media (min-width: 768px) {
		.news-header-content {
			padding: 0 2rem;
		}
	}

	.news-date {
		display: inline-block;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--accent-red);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.75rem;
	}

	.news-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 800;
		font-size: clamp(1.75rem, 4vw, 3rem);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--text-primary);
		margin: 0;
	}

	.news-title::after {
		content: '';
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent-red);
		margin-top: 1rem;
		border-radius: 2px;
	}

	/* === Content Body === */
	.news-body {
		background: var(--bg-primary);
		padding: 3rem 0 4rem;
	}

	.news-container {
		max-width: 780px;
		margin: 0 auto;
		padding: 0 1.5rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		color: var(--text-secondary);
		line-height: 1.85;
		font-size: 1.05rem;
	}

	@media (min-width: 768px) {
		.news-container {
			padding: 0 2rem;
		}
	}

	.news-container :global(h2) {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 700;
		font-size: clamp(1.5rem, 3vw, 2rem);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		margin: 3rem 0 1.25rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-subtle);
	}

	.news-container :global(h3) {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 600;
		font-size: 1.15rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent-red);
		margin: 2rem 0 0.5rem;
	}

	.news-container :global(p) {
		margin: 0 0 1.25rem;
	}

	.news-container :global(strong) {
		color: var(--text-primary);
		font-weight: 500;
	}

	.news-container :global(a) {
		color: var(--accent-red);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.news-container :global(a:hover) {
		color: var(--accent-red-glow);
	}

	.news-container :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
		margin: 2rem 0;
	}

	.news-container :global(blockquote) {
		margin: 3rem 0;
		padding: 2rem 2.5rem;
		border-left: 4px solid var(--accent-red);
		background: var(--bg-surface);
		border-radius: 0 4px 4px 0;
	}

	.news-container :global(blockquote p) {
		font-size: 1.15rem;
		font-style: italic;
		color: var(--text-primary);
		line-height: 1.7;
		margin-bottom: 1rem;
	}

	/* === Back link === */
	.news-back {
		max-width: 780px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	@media (min-width: 768px) {
		.news-back {
			padding: 0 2rem 4rem;
		}
	}

	.news-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--accent-red);
		text-decoration: none;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.news-back-link:hover {
		border-color: var(--accent-red);
		background: var(--bg-surface);
	}

	/* === Reduced motion === */
	@media (prefers-reduced-motion: reduce) {
		.breadcrumb-container a,
		.news-back-link,
		.news-container :global(a) {
			transition: none;
		}
	}
</style>
