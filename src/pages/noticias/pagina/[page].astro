---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import NoticiaCard from '../../../components/NoticiaCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getAllNoticias } from '../../../lib/directus';

// Página 1 vive em /noticias (index); aqui só 2..N.
const currentPage = Number(Astro.params.page);
if (!Number.isInteger(currentPage) || currentPage < 2) return new Response(null, { status: 404 });
const all = await getAllNoticias();
const pageSize = 12;
const lastPage = Math.max(1, Math.ceil(all.length / pageSize));
if (currentPage > lastPage) return new Response(null, { status: 404 });
const start = (currentPage - 1) * pageSize;
const page = { data: all.slice(start, start + pageSize), currentPage, lastPage, total: all.length };
---

<BaseLayout title={`Notícias — página ${page.currentPage} — Condor`} description="Fique por dentro das novidades da Rede Condor.">
  <Header />

  <section class="bg-navy text-white py-12">
    <div class="mx-auto max-w-[1200px] px-6">
      <span class="font-display text-[.72rem] font-bold tracking-[.14em] uppercase text-white/80">Fique por dentro</span>
      <h1 class="text-3xl md:text-5xl font-extrabold mt-3">Notícias</h1>
      <p class="text-white/80 mt-2">Página {page.currentPage} de {page.lastPage} · {page.total} publicações.</p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {page.data.map((n) => <NoticiaCard noticia={n} />)}
      </div>
      <Pagination current={page.currentPage} last={page.lastPage} basePath="/noticias" />
    </div>
  </section>

  <Footer />
</BaseLayout>
