---
// ponytail: página de diagnóstico temporária — remover depois de resolver o logo.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFiles, assetUrl } from '../lib/directus';

const files = await getFiles(60);
const fmtSize = (b: string | null) => (b ? `${(Number(b) / 1024).toFixed(0)} KB` : '—');
---

<BaseLayout title="Preview de arquivos — Directus">
  <main class="mx-auto max-w-[1200px] px-6 py-12">
    <h1 class="text-3xl font-extrabold">Preview de arquivos do Directus</h1>
    <p class="text-muted mt-2">{files.length} arquivos (mais recentes). Página temporária de diagnóstico.</p>

    {files.length === 0 && <p class="mt-8 text-red">Sem arquivos ou credenciais ausentes (.env).</p>}

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 mt-8">
      {files.map((f) => {
        const isSvg = f.type === 'image/svg+xml';
        const url = assetUrl(f.id, isSvg ? '' : 'width=500&fit=contain');
        return (
          <figure class="bg-surface border border-line rounded-card overflow-hidden shadow-sm">
            <div class="aspect-[4/3] grid place-items-center p-3"
                 style="background-image: conic-gradient(#0000 90deg,#8883 0 180deg,#0000 0 270deg,#8883 0); background-size: 20px 20px;">
              {url ? (
                <img src={url} alt={f.title ?? f.filename_download} loading="lazy"
                     class="max-w-full max-h-full object-contain" />
              ) : (
                <span class="text-xs text-muted">sem URL</span>
              )}
            </div>
            <figcaption class="p-3 border-t border-line">
              <div class="font-display font-bold text-sm truncate" title={f.filename_download}>{f.title ?? f.filename_download}</div>
              <div class="flex items-center justify-between mt-1 text-xs text-muted">
                <span class="font-mono">{f.type ?? '?'}</span>
                <span>{fmtSize(f.filesize)}</span>
              </div>
              <code class="block mt-2 text-[.68rem] text-muted break-all select-all">{f.id}</code>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </main>
</BaseLayout>
