---
export const prerender = false;

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchDirectus, assetUrl } from '../../lib/directus';
import '../../styles/global.css';

interface Loja {
	id: string;
	nome: string;
	slug: string;
	cidade: string | null;
	telefone: string | null;
	horarios: string | null;
	link_maps: string | null;
	latitude: string | null;
	longitude: string | null;
	image: string | null;
	setores: string | null;
	servicos: string | null;
}

const { slug } = Astro.params;

const lojas = await fetchDirectus<Loja>(
	`/items/lojas?filter[slug][_eq]=${slug}&filter[status][_eq]=published&fields=*&limit=1`
);

if (lojas.length === 0) {
	return Astro.redirect('/404');
}

const loja = lojas[0];
const heroImage = assetUrl(loja.image, { width: 1200, height: 480, fit: 'cover' }, '') || null;

const setoresList = loja.setores ? loja.setores.split(',').map((s) => s.trim()).filter(Boolean) : [];
const servicosList = loja.servicos ? loja.servicos.split(',').map((s) => s.trim()).filter(Boolean) : [];
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<title>{loja.nome} — Condor</title>
	</head>
	<body>
		<Header />
		<main>
			<!-- Breadcrumb -->
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<div class="breadcrumb-container">
					<a href="/">Início</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<a href="/nossas-lojas">Nossas Lojas</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<span aria-current="page">{loja.nome}</span>
				</div>
			</nav>

			<!-- Hero -->
			<section class:list={["loja-hero", { "no-image": !heroImage }]}>
				{heroImage && (
					<img src={heroImage} alt={loja.nome} class="loja-hero-img" width="1200" height="480" />
				)}
				{heroImage && <div class="loja-hero-overlay"></div>}
				<div class="loja-hero-content">
					<h1 class="loja-hero-title">{loja.nome}</h1>
					<p class="loja-hero-city">{loja.cidade}</p>
				</div>
			</section>

			<!-- Detail content -->
			<article class="loja-detail">
				<div class="loja-container">
					<div class="loja-grid">
						<!-- Main info -->
						<div class="loja-main">
							<!-- Horários -->
							{loja.horarios && (
								<section class="loja-section">
									<h2 class="loja-section-title">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
										</svg>
										Horários de Funcionamento
									</h2>
									<div class="loja-horarios" set:html={loja.horarios} />
								</section>
							)}

							<!-- Setores -->
							{setoresList.length > 0 && (
								<section class="loja-section">
									<h2 class="loja-section-title">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
											<path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" />
										</svg>
										Setores
									</h2>
									<div class="loja-tags">
										{setoresList.map((setor: string) => (
											<span class="loja-tag">{setor}</span>
										))}
									</div>
								</section>
							)}

							<!-- Serviços -->
							{servicosList.length > 0 && (
								<section class="loja-section">
									<h2 class="loja-section-title">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
										</svg>
										Serviços
									</h2>
									<div class="loja-tags">
										{servicosList.map((servico: string) => (
											<span class="loja-tag loja-tag--service">{servico}</span>
										))}
									</div>
								</section>
							)}
						</div>

						<!-- Sidebar -->
						<aside class="loja-sidebar">
							<div class="loja-sidebar-card">
								{loja.telefone && (
									<div class="loja-sidebar-item">
										<span class="loja-sidebar-label">Telefone</span>
										<a href={`tel:${loja.telefone.replace(/[^0-9+]/g, '')}`} class="loja-sidebar-value loja-sidebar-link">
											{loja.telefone}
										</a>
									</div>
								)}

								{loja.cidade && (
									<div class="loja-sidebar-item">
										<span class="loja-sidebar-label">Cidade</span>
										<span class="loja-sidebar-value">{loja.cidade}</span>
									</div>
								)}

								{loja.codigo && (
									<div class="loja-sidebar-item">
										<span class="loja-sidebar-label">Código da Loja</span>
										<span class="loja-sidebar-value">{loja.codigo}</span>
									</div>
								)}

								{loja.link_maps && (
									<a href={loja.link_maps} target="_blank" rel="noopener noreferrer" class="loja-sidebar-cta">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
											<circle cx="12" cy="10" r="3" />
										</svg>
										Como chegar
									</a>
								)}
							</div>

							<a href="/nossas-lojas" class="loja-back-link">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m15 18-6-6 6-6" />
								</svg>
								Voltar para Nossas Lojas
							</a>
						</aside>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	:root {
		--bg-primary: #FFFFFF;
		--bg-surface: #F7F9FC;
		--border-subtle: #E2E8F0;
		--accent-red: #E31937;
		--condor-blue: #01417A;
		--text-primary: #1A1A2E;
		--text-secondary: #4A5568;
		--text-muted: #718096;
	}

	/* === Breadcrumb === */
	.breadcrumb {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border-subtle);
		padding: 0.75rem 0;
	}

	.breadcrumb-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.breadcrumb-container a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb-container a:hover {
		color: var(--accent-red);
	}

	.breadcrumb-sep {
		color: var(--border-subtle);
	}

	.breadcrumb-container [aria-current="page"] {
		color: var(--text-primary);
		font-weight: 500;
	}

	/* === Hero === */
	.loja-hero {
		position: relative;
		min-height: 320px;
		display: flex;
		align-items: flex-end;
		background: var(--condor-blue);
		overflow: hidden;
	}

	.loja-hero.no-image {
		min-height: auto;
	}

	.loja-hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.loja-hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgba(1, 65, 122, 0.9) 0%, rgba(1, 65, 122, 0.3) 50%, transparent 100%);
	}

	.loja-hero-content {
		position: relative;
		z-index: 1;
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 1.5rem 2.5rem;
		width: 100%;
	}

	.loja-hero.no-image .loja-hero-content {
		padding: 2rem 1.5rem 1.5rem;
	}

	@media (min-width: 768px) {
		.loja-hero {
			min-height: 380px;
		}

		.loja-hero.no-image {
			min-height: auto;
		}

		.loja-hero-content {
			padding: 4rem 2rem 3rem;
		}

		.loja-hero.no-image .loja-hero-content {
			padding: 2.5rem 2rem 1.5rem;
		}
	}

	.loja-hero-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 800;
		font-size: clamp(1.75rem, 5vw, 3rem);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
		color: #FFFFFF;
		margin: 0;
	}

	.loja-hero-title::after {
		content: '';
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent-red);
		margin-top: 1rem;
		border-radius: 2px;
	}

	.loja-hero-city {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 1rem;
		color: rgba(255, 255, 255, 0.8);
		margin: 0.75rem 0 0;
	}

	/* === Detail === */
	.loja-detail {
		background: var(--bg-primary);
		padding: 2.5rem 0 4rem;
	}

	.loja-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	@media (min-width: 768px) {
		.loja-container {
			padding: 0 2rem;
		}
	}

	.loja-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}

	@media (min-width: 768px) {
		.loja-grid {
			grid-template-columns: 1fr 320px;
		}
	}

	/* === Main sections === */
	.loja-section {
		margin-bottom: 2.5rem;
	}

	.loja-section:last-child {
		margin-bottom: 0;
	}

	.loja-section-title {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		margin: 0 0 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-subtle);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.loja-section-title svg {
		width: 20px;
		height: 20px;
		color: var(--accent-red);
		flex-shrink: 0;
	}

	/* === Horarios === */
	.loja-horarios {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.75;
	}

	.loja-horarios :global(div) {
		padding: 0.3rem 0;
		border-bottom: 1px solid var(--bg-surface);
	}

	.loja-horarios :global(div:last-child) {
		border-bottom: none;
	}

	.loja-horarios :global(strong) {
		color: var(--text-primary);
		font-weight: 500;
	}

	/* === Tags === */
	.loja-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.loja-tag {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--text-secondary);
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		padding: 0.35rem 0.75rem;
		border-radius: 3px;
	}

	.loja-tag--service {
		border-color: var(--condor-blue);
		color: var(--condor-blue);
		background: rgba(1, 65, 122, 0.04);
	}

	/* === Sidebar === */
	.loja-sidebar-card {
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.loja-sidebar-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.loja-sidebar-label {
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 600;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
	}

	.loja-sidebar-value {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--text-primary);
		font-weight: 500;
	}

	.loja-sidebar-link {
		text-decoration: none;
		color: var(--condor-blue);
	}

	.loja-sidebar-link:hover {
		text-decoration: underline;
	}

	.loja-sidebar-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		background: var(--condor-blue);
		color: #FFFFFF;
		font-family: 'Barlow Condensed', sans-serif;
		font-weight: 600;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		text-decoration: none;
		border-radius: 4px;
		transition: background 0.2s ease;
		margin-top: 0.5rem;
	}

	.loja-sidebar-cta svg {
		width: 18px;
		height: 18px;
	}

	.loja-sidebar-cta:hover {
		background: #015A9E;
	}

	.loja-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.25rem;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.loja-back-link svg {
		width: 16px;
		height: 16px;
	}

	.loja-back-link:hover {
		color: var(--condor-blue);
	}

	/* === Reduced motion === */
	@media (prefers-reduced-motion: reduce) {
		.loja-card-btn,
		.loja-sidebar-cta,
		.loja-back-link,
		.breadcrumb-container a {
			transition: none;
		}
	}
</style>
