---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPage, assetUrl } from '../../lib/directus';
import { labelCategoria } from '../../lib/format';

const page = await getPage(Astro.params.slug!);
if (!page || page.categoria !== Astro.params.categoria) return new Response(null, { status: 404 });
const catLabel = labelCategoria(page.categoria);
const img = assetUrl(page.image, 'width=1600&height=800&fit=cover');
const ogImg = assetUrl(page.image, 'width=1200&height=630&fit=cover');
const seoTitle = page.seo?.title ?? page.titulo;
const seoDesc = page.seo?.meta_description ?? undefined;
---

<BaseLayout title={`${seoTitle} — Condor`} description={seoDesc} image={ogImg}>
  <Header />

  <article>
    <header class="bg-navy text-white py-12">
      <div class="mx-auto max-w-[820px] px-6">
        {page.categoria && (
          <a href={`/${page.categoria}`} class="text-white/70 hover:text-white text-sm font-display tracking-wide uppercase">← {catLabel}</a>
        )}
        <h1 class="text-3xl md:text-5xl font-extrabold mt-3 leading-tight">{page.titulo}</h1>
      </div>
    </header>

    <div class="mx-auto max-w-[820px] px-6 py-10">
      {img && (
        <img src={img} alt={page.titulo} width="1600" height="800"
             class="w-full aspect-[2/1] object-cover rounded-card border border-line mb-10" />
      )}
      {page.content
        ? <div class="prose-condor" set:html={page.content} />
        : <p class="text-muted">Conteúdo indisponível.</p>}
    </div>
  </article>

  <Footer />
</BaseLayout>
