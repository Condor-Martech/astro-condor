---
import { assetUrl } from '../lib/directus';
import { ddmm } from '../lib/format';
import type { Tabloide } from '../lib/types';

const { t } = Astro.props as { t: Tabloide };
const capa = assetUrl(t.capa, 'width=640&height=853&fit=cover');
const pdf = assetUrl(t.pdf);
const validade = t.valido_de || t.valido_ate
  ? `${t.valido_de ? ddmm(t.valido_de) : ''}${t.valido_de && t.valido_ate ? ' a ' : ''}${t.valido_ate ? ddmm(t.valido_ate) : ''}`
  : null;
---

<article class="group flex flex-col bg-surface border border-line rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300">
  <div class="relative aspect-[3/4] bg-surface-2 overflow-hidden">
    {capa ? (
      <img src={capa} alt={`Capa do tabloide ${t.titulo}`} loading="lazy" width="640" height="853"
           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
    ) : (
      <div class="w-full h-full grid place-items-center text-center p-6 text-white/90 font-display font-bold bg-gradient-to-br from-navy to-red">{t.titulo}</div>
    )}
    {validade && (
      <span class="absolute bottom-2 left-2 z-10 inline-flex items-center bg-black/65 backdrop-blur-sm text-white text-[.7rem] font-medium px-2.5 py-1 rounded-lg">
        {validade}
      </span>
    )}
  </div>

  <div class="p-3.5 flex flex-col gap-2.5 flex-1">
    <h3 class="font-display font-bold text-[.9rem] leading-snug text-ink line-clamp-2">{t.titulo}</h3>
    {t.paginas && <span class="text-muted text-xs -mt-1.5">{t.paginas} páginas</span>}
    <div class="mt-auto flex items-center gap-2 pt-1">
      {pdf && (
        <button type="button"
                data-folhear data-pdf={pdf} data-titulo={t.titulo} data-download={pdf}
                class="flex-1 inline-flex items-center justify-center gap-1.5 bg-navy text-white text-xs font-display font-semibold py-2 px-3 rounded-lg transition-colors hover:bg-[#013363]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M2 6s1.5-1 4-1 4 1 4 1v13s-1.5-1-4-1-4 1-4 1zM22 6s-1.5-1-4-1-4 1-4 1v13s1.5-1 4-1 4 1 4 1z"/></svg>
          Folhear
        </button>
      )}
      {pdf && (
        <a href={pdf} target="_blank" rel="noopener" title="Baixar PDF"
           class="shrink-0 grid place-items-center w-9 h-9 rounded-lg border border-line text-muted transition-colors hover:bg-surface-2 hover:text-ink"
           aria-label={`Baixar PDF do tabloide ${t.titulo}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M12 3v12m0 0l4-4m-4 4l-4-4M5 21h14"/></svg>
        </a>
      )}
    </div>
  </div>
</article>
