---
// Visor de tabloide simples e robusto: pdf.js renderiza cada página a canvas,
// exibidas num carrossel scroll-snap horizontal (swipe nativo). O fit é 100% CSS
// (max-width/height) → nunca desborda, aspect do PDF é irrelevante. Zoom faz pan.
// Modal único; os cards disparam via [data-folhear] com data-pdf/data-titulo/data-download.
// pdf.js carrega sob demanda (dynamic import) só ao abrir → zero peso no load.
---

<div id="tv-modal" class="tv" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Visualizador de tabloide">
  <div class="tv-backdrop" data-tv-close></div>

  <div class="tv-shell" role="document">
    <header class="tv-bar">
      <span class="tv-title font-display" data-tv-title>Tabloide</span>
      <div class="tv-tools">
        <button type="button" class="tv-btn" data-tv-zoom="-1" aria-label="Diminuir zoom">−</button>
        <button type="button" class="tv-btn" data-tv-zoom="1" aria-label="Aumentar zoom">+</button>
        <a class="tv-btn tv-dl" data-tv-download href="#" target="_blank" rel="noopener" aria-label="Baixar PDF">↓</a>
        <button type="button" class="tv-btn tv-close" data-tv-close aria-label="Fechar visualizador">✕</button>
      </div>
    </header>

    <div class="tv-stage">
      <button type="button" class="tv-nav tv-prev" data-tv-prev aria-label="Página anterior">‹</button>
      <div class="tv-track" data-tv-track></div>
      <button type="button" class="tv-nav tv-next" data-tv-next aria-label="Próxima página">›</button>

      <div class="tv-status" data-tv-status>
        <span class="tv-spinner" aria-hidden="true"></span>
        <span data-tv-status-text>Carregando encarte…</span>
      </div>
    </div>

    <footer class="tv-foot font-display">
      <span data-tv-counter>—</span>
      <span class="tv-hint">use ‹ › ou arraste</span>
    </footer>
  </div>
</div>

<style>
  .tv { position: fixed; inset: 0; z-index: 80; display: grid; }
  .tv[hidden] { display: none; }
  .tv-backdrop { position: absolute; inset: 0; background: radial-gradient(120% 120% at 50% 0%, #0a2038 0%, #05121f 60%, #020a12 100%); }

  .tv-shell {
    position: relative; z-index: 1; display: grid;
    grid-template-rows: auto 1fr auto; width: 100%; height: 100%; min-height: 0;
    animation: tv-in .28s cubic-bezier(.2,.8,.2,1);
  }
  @keyframes tv-in { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }

  .tv-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1.1rem; color: #fff; }
  .tv-title { font-weight: 800; font-size: 1rem; letter-spacing: .01em; text-shadow: 0 1px 2px rgba(0,0,0,.4); }
  .tv-tools { display: flex; align-items: center; gap: .4rem; }
  .tv-btn {
    display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: 9999px;
    background: rgba(255,255,255,.1); color: #fff; font-size: 1.15rem; line-height: 1; text-decoration: none;
    border: 1px solid rgba(255,255,255,.14); transition: background .2s, transform .2s, border-color .2s;
  }
  .tv-btn:hover { background: rgba(255,255,255,.22); }
  .tv-close:hover { background: var(--c-red); border-color: var(--c-red); }
  .tv-dl { font-size: 1.2rem; }

  .tv-stage { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; min-height: 0; padding: 0 .4rem; }

  /* Carrossel: 1 página por slide, snap horizontal, swipe nativo. */
  .tv-track {
    height: 100%; min-height: 0; display: flex; overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .tv-track::-webkit-scrollbar { display: none; }
  /* Cada slide ocupa o viewport do track; a página entra INTEIRA (contain) e faz pan com zoom. */
  .tv-track :global(.tv-frame) {
    flex: 0 0 100%; width: 100%; height: 100%; scroll-snap-align: center;
    display: flex; align-items: safe center; justify-content: safe center;
    overflow: auto; padding: 1rem clamp(.25rem, 2.5vw, 2.5rem);
  }
  /* Fit contain: página inteira visível (z=1); zoom multiplica ambos os eixos → cresce e faz pan. */
  .tv-track :global(.tv-frame canvas) {
    display: block; width: auto; height: auto;
    max-width: calc(var(--tv-zoom, 1) * 100%); max-height: calc(var(--tv-zoom, 1) * 100%);
    background: #fff; box-shadow: 0 24px 60px -18px rgba(0,0,0,.65);
  }

  .tv-nav {
    z-index: 2; display: grid; place-items: center; width: 3rem; height: 3rem; margin: 0 .2rem; flex: none;
    border-radius: 9999px; background: rgba(255,255,255,.12); color: #fff; font-size: 1.8rem; line-height: 1;
    border: 1px solid rgba(255,255,255,.16); transition: background .2s, transform .2s;
  }
  .tv-nav:hover { background: var(--c-navy); border-color: rgba(255,255,255,.3); }
  .tv-nav:disabled { opacity: .3; pointer-events: none; }

  .tv-status {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: .9rem;
    color: #cfe0f0; font-size: .95rem; pointer-events: none;
  }
  .tv-status[hidden] { display: none; }
  .tv-spinner { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 3px solid rgba(255,255,255,.25); border-top-color: #fff; animation: tv-spin .8s linear infinite; }
  @keyframes tv-spin { to { transform: rotate(360deg); } }

  .tv-foot { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: .7rem 1rem 1rem; color: #bcd0e4; font-size: .82rem; }
  .tv-foot [data-tv-counter] { font-weight: 800; color: #fff; letter-spacing: .04em; }
  .tv-hint { opacity: .7; }
  @media (max-width: 640px) { .tv-hint { display: none; } .tv-nav { width: 2.5rem; height: 2.5rem; font-size: 1.4rem; } }

  @media (prefers-reduced-motion: reduce) {
    .tv-shell { animation: none; }
    .tv-track { scroll-behavior: auto; }
    .tv-spinner { animation-duration: 1.6s; }
  }
</style>

<script>
  const RENDER_SCALE = 2;  // hi-dpi das páginas
  const MAX_PAGES = 40;    // trava de segurança
  const ZOOM_STEP = 0.25, ZOOM_MIN = 1, ZOOM_MAX = 3;

  const setupTabloideViewer = () => {
    const modal = document.getElementById('tv-modal');
    if (!modal || modal.dataset.bound) return;
    modal.dataset.bound = '1';

    const $ = (s: string) => modal.querySelector(s) as HTMLElement | null;
    const trackEl = $('[data-tv-track]') as HTMLElement;
    const statusEl = $('[data-tv-status]') as HTMLElement;
    const statusText = $('[data-tv-status-text]') as HTMLElement;
    const titleEl = $('[data-tv-title]') as HTMLElement;
    const counterEl = $('[data-tv-counter]') as HTMLElement;
    const dlEl = $('[data-tv-download]') as HTMLAnchorElement;
    const prevBtn = $('[data-tv-prev]') as HTMLButtonElement;
    const nextBtn = $('[data-tv-next]') as HTMLButtonElement;

    let zoom = 1;
    let total = 0;
    let token = 0; // invalida renders de aberturas anteriores

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setZoom = (z: number) => { zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, z)); trackEl.style.setProperty('--tv-zoom', String(zoom)); };
    const lockScroll = (on: boolean) => { document.documentElement.style.overflow = on ? 'hidden' : ''; };

    const curIdx = () => Math.round(trackEl.scrollLeft / Math.max(1, trackEl.clientWidth));
    const update = () => {
      const i = curIdx();
      counterEl.textContent = total ? `${Math.min(i + 1, total)} / ${total}` : '—';
      prevBtn.disabled = i <= 0;
      nextBtn.disabled = i >= total - 1;
    };
    const goto = (dir: number) => { setZoom(1); trackEl.scrollBy({ left: dir * trackEl.clientWidth }); };

    const close = () => {
      modal.setAttribute('hidden', '');
      modal.setAttribute('aria-hidden', 'true');
      token++;            // cancela render em andamento
      trackEl.innerHTML = '';
      total = 0;
      lockScroll(false);
    };

    async function open(pdfUrl: string, titulo: string, downloadUrl: string) {
      const my = ++token;
      titleEl.textContent = titulo;
      dlEl.href = downloadUrl || pdfUrl;
      setZoom(1);
      trackEl.innerHTML = '';
      total = 0;
      update();
      statusText.textContent = 'Carregando encarte…';
      statusEl.removeAttribute('hidden');
      modal.removeAttribute('hidden');
      modal.setAttribute('aria-hidden', 'false');
      lockScroll(true);

      try {
        const [pdfjs, workerMod] = await Promise.all([
          import('pdfjs-dist'),
          import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
        ]);
        if (my !== token) return;
        pdfjs.GlobalWorkerOptions.workerSrc = (workerMod as any).default;

        const doc = await pdfjs.getDocument({ url: pdfUrl }).promise;
        if (my !== token) return;

        total = Math.min(doc.numPages, MAX_PAGES);
        for (let i = 1; i <= total; i++) {
          const page = await doc.getPage(i);
          if (my !== token) return;
          const vp = page.getViewport({ scale: RENDER_SCALE });
          const canvas = document.createElement('canvas');
          canvas.width = vp.width; canvas.height = vp.height;
          await page.render({ canvasContext: canvas.getContext('2d')!, viewport: vp }).promise;
          if (my !== token) return;
          const frame = document.createElement('div');
          frame.className = 'tv-frame';
          frame.appendChild(canvas);
          trackEl.appendChild(frame);
          statusText.textContent = `Renderizando página ${i} de ${total}…`;
        }

        statusEl.setAttribute('hidden', '');
        trackEl.scrollLeft = 0;
        update();
      } catch (err) {
        if (my !== token) return;
        console.error('[tabloide] falha ao abrir PDF:', err);
        statusText.textContent = 'Não foi possível carregar o encarte. Use o botão ↓ para baixar o PDF.';
      }
    }

    // Disparadores (cards da página)
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-folhear]') as HTMLElement | null;
      if (!trigger) return;
      e.preventDefault();
      open(trigger.dataset.pdf || '', trigger.dataset.titulo || 'Tabloide', trigger.dataset.download || trigger.dataset.pdf || '');
    });

    modal.querySelectorAll('[data-tv-close]').forEach((el) => el.addEventListener('click', close));
    prevBtn.addEventListener('click', () => goto(-1));
    nextBtn.addEventListener('click', () => goto(1));
    modal.querySelectorAll('[data-tv-zoom]').forEach((el) =>
      el.addEventListener('click', () => setZoom(zoom + ZOOM_STEP * Number((el as HTMLElement).dataset.tvZoom))));

    // ponytail: rAF por scroll é barato; só lê scrollLeft/clientWidth.
    let raf = 0;
    trackEl.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); });

    document.addEventListener('keydown', (e) => {
      if (modal.hasAttribute('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') goto(-1);
      else if (e.key === 'ArrowRight') goto(1);
    });
  };

  document.addEventListener('astro:page-load', setupTabloideViewer);
</script>
