---
// Paginação SSG. Esquema de URL: página 1 = basePath, página n = basePath/pagina/n.
interface Props { current: number; last: number; basePath: string; }
const { current, last, basePath } = Astro.props;

const href = (n: number) => (n <= 1 ? basePath : `${basePath}/pagina/${n}`);

// Janela: 1 … (cur-1) cur (cur+1) … last
const nums = new Set<number>([1, last, current, current - 1, current + 1]);
const pages = [...nums].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
const withGaps: (number | '…')[] = [];
pages.forEach((n, i) => {
  if (i > 0 && n - pages[i - 1] > 1) withGaps.push('…');
  withGaps.push(n);
});
---
{last > 1 && (
  <nav class="flex items-center justify-center gap-1.5 mt-12" aria-label="Paginação">
    <a href={href(current - 1)} aria-label="Página anterior" aria-disabled={current === 1}
       class:list={['grid place-items-center w-10 h-10 rounded-lg border border-line font-display font-bold', current === 1 ? 'opacity-40 pointer-events-none' : 'hover:border-navy hover:bg-surface-2']}>‹</a>

    {withGaps.map((p) => (
      p === '…'
        ? <span class="grid place-items-center w-10 h-10 text-muted">…</span>
        : <a href={href(p)} aria-current={p === current ? 'page' : undefined}
             class:list={['grid place-items-center min-w-10 h-10 px-3 rounded-lg border font-display font-bold tabular-nums',
               p === current ? 'bg-navy text-white border-navy' : 'border-line hover:border-navy hover:bg-surface-2']}>{p}</a>
    ))}

    <a href={href(current + 1)} aria-label="Próxima página" aria-disabled={current === last}
       class:list={['grid place-items-center w-10 h-10 rounded-lg border border-line font-display font-bold', current === last ? 'opacity-40 pointer-events-none' : 'hover:border-navy hover:bg-surface-2']}>›</a>
  </nav>
)}
