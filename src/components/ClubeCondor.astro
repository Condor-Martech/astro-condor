---
interface Benefit {
  text: string;
}

const benefits: Benefit[] = [
  { text: 'Cashback em todas as compras' },
  { text: 'Descontos exclusivos para membros' },
  { text: 'Concorra a prêmios todos os meses' },
];
---

<section class="clube" id="clube-condor" aria-labelledby="clube-heading">
  <div class="clube-bg" aria-hidden="true">
    <div class="clube-bg-glow clube-bg-glow--gold"></div>
    <div class="clube-bg-glow clube-bg-glow--cyan"></div>
    <div class="clube-bg-dots"></div>
  </div>

  <div class="clube-wrapper">
    <div class="clube-grid">

      <div class="clube-content">
        <span class="clube-chip">
          <img src="https://clubecondor.com/images/clube-condor-logo.gif" alt="Clube Condor" width="20" height="20" class="clube-chip-icon" loading="lazy" />
          Aplicativo gratuito
        </span>

        <h2 class="clube-title" id="clube-heading">
          Cashback, descontos<br/>e prêmios na palma<br/><span>da sua mão.</span>
        </h2>

        <p class="clube-desc">
          O app do Clube Condor reúne tudo: ofertas exclusivas, dinheiro de volta nas suas compras e participação automática nas campanhas mensais.
        </p>

        <ul class="clube-benefits" role="list">
          {benefits.map((b) => (
            <li class="clube-benefit">
              <span class="clube-benefit-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span>{b.text}</span>
            </li>
          ))}
        </ul>

        <div class="clube-cta-row">
          <div class="clube-badges">
            <a
              href="https://apps.apple.com/br/app/novo-app-clube-condor/id6446367529"
              target="_blank"
              rel="noopener"
              class="clube-badge"
              aria-label="Baixar na App Store"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>
              <span class="clube-badge-text">
                <span class="clube-badge-small">Baixar na</span>
                <span class="clube-badge-big">App Store</span>
              </span>
            </a>
            <a
              href="https://play.google.com/store/apps/details?id=com.bankeiro.zon&hl=pt_BR"
              target="_blank"
              rel="noopener"
              class="clube-badge"
              aria-label="Baixar na Google Play"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#34A853" d="M3 20.5V3.5c0-.6.3-1.1.8-1.4l11.6 11.6L3.8 21.9c-.5-.3-.8-.8-.8-1.4z"/>
                <path fill="#FBBC04" d="M16.8 16.5L13.4 13.7l3.4-3.4 4.5 2.5c1 .5 1 1.9 0 2.5l-4.5 1.2z"/>
                <path fill="#EA4335" d="M3.8 2.1L15.4 13.7l-3.4 3.4L3 20.5c0-.1 0-.1 0-.2L3 3.7c0-.1 0-.1.8-1.6z"/>
                <path fill="#4285F4" d="M3.8 2.1c.4-.2.9-.1 1.4.1l12.7 7.2-3.4 3.4L3.8 2.1z"/>
              </svg>
              <span class="clube-badge-text">
                <span class="clube-badge-small">Disponível no</span>
                <span class="clube-badge-big">Google Play</span>
              </span>
            </a>
          </div>

          <div class="clube-qr">
            <img
              src="https://premia.condor.com.br/images/section-six-qrcode.webp"
              alt="QR Code para baixar o aplicativo"
              width="100"
              height="100"
              loading="lazy"
            />
            <span>Escaneie e baixe</span>
          </div>
        </div>
      </div>

      <div class="clube-visual">
        <img
          src="https://clubecondor.com/images/section-one-bg-desktop-new.webp"
          alt="Aplicativo Clube Condor mostrando ofertas exclusivas e cashback"
          class="clube-mockup"
          width="1400"
          height="900"
          loading="lazy"
          fetchpriority="low"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .clube {
    --c-blue-deep: #001752;
    --c-blue: #0033A0;
    --c-blue-bright: #1947C7;
    --c-blue-light: #4D7BE8;
    --c-red: #E31937;
    --c-red-glow: #FF2D4B;
    --c-gold: #FFD13C;
    --c-gold-light: #FFE572;
    --c-text: #FFFFFF;
    --c-text-soft: #C8D8F5;
    --c-text-muted: #8FA5D1;
    --c-border: hsla(0, 0%, 100%, 0.12);
    --c-border-strong: hsla(0, 0%, 100%, 0.22);

    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, var(--c-blue-deep) 0%, var(--c-blue) 55%, var(--c-blue-bright) 100%);
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--c-text);
    isolation: isolate;
  }

  /* === Background layers === */
  .clube-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .clube-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    will-change: transform;
  }

  .clube-bg-glow--gold {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, var(--c-gold) 0%, transparent 70%);
    top: -180px;
    right: 10%;
    opacity: 0.18;
    animation: clube-float 18s ease-in-out infinite;
  }

  .clube-bg-glow--cyan {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, var(--c-blue-light) 0%, transparent 70%);
    bottom: -300px;
    left: -200px;
    opacity: 0.35;
    animation: clube-float 24s ease-in-out infinite reverse;
  }

  @keyframes clube-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(30px, -40px, 0); }
  }

  .clube-bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(hsla(0, 0%, 100%, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 90% at 30% 50%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 90% at 30% 50%, #000 0%, transparent 70%);
    opacity: 0.6;
  }

  /* === Wrapper === */
  .clube-wrapper {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem;
  }

  @media (min-width: 768px) {
    .clube-wrapper {
      padding: 5rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .clube-wrapper {
      padding: 6rem 2.5rem;
    }
  }

  /* === Grid === */
  .clube-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .clube-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }

  /* === Content column === */
  .clube-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 540px;
  }

  @media (min-width: 1024px) {
    .clube-content {
      max-width: none;
    }
  }

  .clube-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem 0.4rem 0.5rem;
    background: hsla(0, 0%, 100%, 0.08);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-text);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .clube-chip-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
    background: #fff;
  }

  .clube-title {
    margin: 1.25rem 0 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: clamp(2.1rem, 5.5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--c-text);
    text-wrap: balance;
  }

  .clube-title span {
    background: linear-gradient(180deg, var(--c-gold-light) 0%, var(--c-gold) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .clube-desc {
    margin: 1.25rem 0 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--c-text-soft);
    max-width: 480px;
  }

  @media (max-width: 767px) {
    .clube-desc {
      font-size: 0.95rem;
    }
  }

  /* === Benefits list === */
  .clube-benefits {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .clube-benefit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.98rem;
    color: var(--c-text);
    line-height: 1.35;
  }

  .clube-benefit-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--c-gold);
    color: var(--c-blue-deep);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .clube-benefit-check svg {
    width: 13px;
    height: 13px;
  }

  /* === CTA row === */
  .clube-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .clube-badges {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @media (min-width: 420px) {
    .clube-badges {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .clube-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 52px;
    padding: 0.5rem 1.15rem 0.5rem 0.95rem;
    background: #000;
    border: 1px solid hsla(0, 0%, 100%, 0.2);
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .clube-badge svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .clube-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .clube-badge-small {
    font-size: 0.6rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
    margin-bottom: 2px;
  }

  .clube-badge-big {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .clube-badge:hover {
    transform: translateY(-2px);
    background: #1a1a1a;
    border-color: hsla(0, 0%, 100%, 0.35);
  }

  .clube-badge:focus-visible {
    outline: 2px solid var(--c-gold);
    outline-offset: 3px;
  }

  /* === QR (desktop only) === */
  .clube-qr {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .clube-qr img {
    width: 84px;
    height: 84px;
    display: block;
    border-radius: 4px;
  }

  .clube-qr span {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--c-blue-deep);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: center;
    line-height: 1;
    padding-bottom: 0.15rem;
  }

  @media (min-width: 768px) {
    .clube-qr {
      display: inline-flex;
    }
  }

  /* === Visual column (phone mockup) === */
  .clube-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .clube-mockup {
    width: 100%;
    height: auto;
    max-width: 720px;
    display: block;
    filter: drop-shadow(0 30px 60px rgba(0, 10, 50, 0.45));
    animation: clube-mockup-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes clube-mockup-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* On large desktops, let the mockup push outside the column slightly */
  @media (min-width: 1280px) {
    .clube-visual {
      margin-right: -2rem;
    }
    .clube-mockup {
      max-width: 780px;
    }
  }

  /* === Reduced motion === */
  @media (prefers-reduced-motion: reduce) {
    .clube-bg-glow,
    .clube-mockup,
    .clube-badge {
      animation: none;
      transition: none;
    }
    .clube-mockup {
      opacity: 1;
      transform: none;
    }
  }
</style>
