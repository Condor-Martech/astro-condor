---
interface Store {
  name: string;
  city: string;
}

const allStores: Store[] = [
  { name: 'Loja Shopping Estação', city: 'Curitiba' },
  { name: 'Loja Cabral', city: 'Curitiba' },
  { name: 'Loja Campo Comprido', city: 'Curitiba' },
  { name: 'Loja Batel', city: 'Curitiba' },
  { name: 'Loja Centro Cívico', city: 'Curitiba' },
  { name: 'Loja Pinhais', city: 'Pinhais' },
  { name: 'Loja São José dos Pinhais', city: 'São José dos Pinhais' },
  { name: 'Loja Colombo', city: 'Colombo' },
  { name: 'Loja Londrina', city: 'Londrina' },
  { name: 'Loja Maringá', city: 'Maringá' },
  { name: 'Loja Ponta Grossa', city: 'Ponta Grossa' },
  { name: 'Loja Cascavel', city: 'Cascavel' },
  { name: 'Loja Joinville', city: 'Joinville' },
  { name: 'Loja Florianópolis', city: 'Florianópolis' },
  { name: 'Loja Blumenau', city: 'Blumenau' },
  { name: 'Loja Itajaí', city: 'Itajaí' },
  { name: 'Loja Guarapuava', city: 'Guarapuava' },
  { name: 'Loja Paranaguá', city: 'Paranaguá' },
  { name: 'Loja Araucária', city: 'Araucária' },
  { name: 'Loja Campo Largo', city: 'Campo Largo' },
];

const shuffled = [...allStores].sort(() => Math.random() - 0.5);
const stores = shuffled.slice(0, 10);

function slugify(name: string): string {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}
---

<section class="store-showcase" aria-label="Nossa rede de lojas">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

  <div class="store-showcase-container">
    <div class="store-showcase-block">
      <!-- Left Panel — Carousel -->
      <div
        class="store-carousel"
        role="region"
        aria-label="Fotos das lojas Condor"
        aria-roledescription="carousel"
        id="store-carousel"
      >
        <div class="store-carousel-viewport">
          {stores.map((store, i) => {
            const slug = slugify(store.name);
            const imgUrl = `https://picsum.photos/seed/${slug}/800/500`;
            return (
              <div
                class={`store-slide ${i === 0 ? 'store-slide--active' : ''}`}
                role="tabpanel"
                id={`store-slide-${i}`}
                aria-label={`${store.name} — ${store.city}`}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <img
                  src={imgUrl}
                  alt={`Fachada da ${store.name} em ${store.city}`}
                  class="store-slide-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  width="800"
                  height="500"
                />
                <div class="store-slide-gradient" aria-hidden="true"></div>
                <span class="store-slide-name">{store.name} — {store.city}</span>
              </div>
            );
          })}
        </div>

        <!-- Carousel dots -->
        <div class="store-carousel-dots" role="tablist" aria-label="Navegar pelas fotos das lojas">
          {stores.map((store, i) => (
            <button
              type="button"
              role="tab"
              class={`store-dot ${i === 0 ? 'store-dot--active' : ''}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Ver ${store.name}`}
              aria-controls={`store-slide-${i}`}
              data-index={i}
            ></button>
          ))}
        </div>
      </div>

      <!-- Right Panel — Stats & CTA -->
      <div class="store-info">
        <div class="store-info-content">
          <span class="store-info-label">Nossa Rede</span>
          <span class="store-info-number">67</span>
          <span class="store-info-headline">Lojas para te atender</span>
          <p class="store-info-desc">
            Encontre a unidade mais próxima em Paraná, Santa Catarina e São Paulo
          </p>
          <a href="/nossas-lojas" class="store-info-cta">
            Encontrar loja mais próxima
            <svg class="store-info-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .store-showcase {
    --condor-blue: #01417A;
    --condor-blue-deep: #0158A7;

    font-family: 'DM Sans', system-ui, sans-serif;
    background: #FFFFFF;
    padding: 1.5rem 0;
    position: relative;
  }

  .store-showcase-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 768px) {
    .store-showcase-container {
      padding: 0 2rem;
    }
  }

  /* === Split Block === */
  .store-showcase-block {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 36, 86, 0.08);
    animation: card-in 0.5s ease both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .store-showcase-block {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .store-showcase-block {
      grid-template-columns: 55% 45%;
    }
  }

  /* === Left Panel — Carousel === */
  .store-carousel {
    position: relative;
    background: #1A1A2E;
    min-height: 280px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .store-carousel {
      min-height: 380px;
    }
  }

  .store-carousel-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  /* === Slides === */
  .store-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: 1;
  }

  .store-slide--active {
    opacity: 1;
    z-index: 2;
  }

  .store-slide-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .store-slide-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
    z-index: 3;
    pointer-events: none;
  }

  .store-slide-name {
    position: absolute;
    bottom: 2.5rem;
    left: 1.25rem;
    z-index: 4;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* === Carousel Dots === */
  .store-carousel-dots {
    position: absolute;
    bottom: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .store-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50px;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .store-dot:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  .store-dot--active {
    width: 24px;
    background: #FFFFFF;
  }

  /* === Right Panel — Stats === */
  .store-info {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #01417A;
    padding: 2.5rem 2rem;
    position: relative;
  }

  @media (min-width: 768px) {
    .store-info {
      padding: 3rem 2.5rem;
    }
  }

  /* Diagonal cut overlapping from blue panel onto the image */
  @media (min-width: 768px) {
    .store-carousel::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: -1px;
      width: 60px;
      background: #01417A;
      clip-path: polygon(100% 0, 100% 100%, 0 100%);
      z-index: 6;
    }
  }

  .store-info-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .store-info-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.25rem;
  }

  .store-info-number {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(4.5rem, 10vw, 7rem);
    line-height: 1;
    color: #FFFFFF;
    margin-bottom: 0.15rem;
  }

  .store-info-headline {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    font-style: italic;
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .store-info-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    max-width: 300px;
    margin: 0 0 1.75rem;
  }

  /* === CTA Button === */
  .store-info-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    background: #FFFFFF;
    color: var(--condor-blue);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: 50px;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .store-info-cta:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .store-info-cta:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 4px;
  }

  .store-info-cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .store-info-cta:hover .store-info-cta-arrow {
    transform: translateX(3px);
  }

  /* === Reduced Motion === */
  @media (prefers-reduced-motion: reduce) {
    .store-showcase-block {
      animation: none;
    }

    .store-slide {
      transition: none;
    }

    .store-dot {
      transition: none;
    }

    .store-info-cta,
    .store-info-cta-arrow {
      transition: none;
    }
  }
</style>

<script>
  const carousel = document.getElementById('store-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>('.store-slide');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('.store-dot');
    const slideCount = slides.length;
    let currentIndex = 0;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function goToSlide(index: number) {
      slides[currentIndex].classList.remove('store-slide--active');
      slides[currentIndex].setAttribute('aria-hidden', 'true');
      dots[currentIndex].classList.remove('store-dot--active');
      dots[currentIndex].setAttribute('aria-selected', 'false');

      currentIndex = index;

      slides[currentIndex].classList.add('store-slide--active');
      slides[currentIndex].setAttribute('aria-hidden', 'false');
      dots[currentIndex].classList.add('store-dot--active');
      dots[currentIndex].setAttribute('aria-selected', 'true');
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slideCount);
    }

    function startAutoplay() {
      if (prefersReducedMotion) return;
      stopAutoplay();
      autoplayTimer = setInterval(nextSlide, 4000);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Dot navigation
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.dataset.index);
        if (!Number.isNaN(idx) && idx !== currentIndex) {
          goToSlide(idx);
          startAutoplay(); // Reset timer on manual nav
        }
      });
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);

    // Pause on focus within carousel (keyboard nav)
    carousel.addEventListener('focusin', stopAutoplay);
    carousel.addEventListener('focusout', startAutoplay);

    // Start autoplay
    startAutoplay();
  }
</script>
