---
import type { Page } from '../lib/types';
import { assetUrl } from '../lib/directus';

interface Props { page: Page; }
const { page } = Astro.props;
const img = assetUrl(page.image, 'width=600&height=400&fit=cover');
const href = `/${page.categoria}/${page.slug}`;
---
<a href={href}
   class="group flex flex-col bg-surface border border-line rounded-card overflow-hidden shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg hover:border-navy">
  <div class="px-[1.1rem] pt-[1.1rem] flex justify-center">
    {img ? (
      <img src={img} alt={page.titulo} loading="lazy" width="600" height="400"
           class="w-full aspect-[3/2] object-cover rounded-[10px]" />
    ) : (
      <div class="w-full aspect-[3/2] rounded-[10px] grid place-items-center text-center p-4 text-white/85 font-display font-bold bg-gradient-to-br from-navy to-red">{page.titulo}</div>
    )}
  </div>
  <div class="p-5 flex flex-col gap-2 flex-1">
    <h3 class="font-display font-bold text-[1.08rem] leading-tight">{page.titulo}</h3>
    <span class="mt-auto inline-flex items-center gap-1 font-display font-bold text-[.88rem] text-red">
      Ver <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </span>
  </div>
</a>
