---
import type { Noticia } from '../lib/types';
import { assetUrl } from '../lib/directus';
import { formatDate } from '../lib/format';

interface Props { noticia: Noticia; }
const { noticia } = Astro.props;
const img = assetUrl(noticia.image, 'width=600&height=380&fit=cover');
const data = formatDate(noticia.data_publicacao);
---
<article class="flex flex-col bg-surface border border-line rounded-card overflow-hidden shadow-sm transition-transform hover:-translate-y-1 hover:border-navy">
  {/* thumbnail centralizado (padding, não full-bleed) */}
  <div class="px-[1.1rem] pt-[1.1rem] flex justify-center">
    {img ? (
      <img src={img} alt={noticia.titulo} loading="lazy" width="600" height="375"
           class="w-full aspect-[16/10] object-cover rounded-[10px]" />
    ) : (
      <div class="w-full aspect-[16/10] rounded-[10px] grid place-items-center text-center p-4 text-white/85 font-display font-bold bg-gradient-to-br from-navy to-red">
        {noticia.titulo.slice(0, 40)}
      </div>
    )}
  </div>
  <div class="p-5 flex flex-col gap-2 flex-1">
    {data && <span class="self-start font-display text-[.68rem] font-bold tracking-wide uppercase text-navy bg-surface-2 px-2.5 py-1 rounded-full">{data}</span>}
    <h3 class="font-display font-bold text-[1.08rem] leading-tight line-clamp-2">
      <a href={`/noticias/${noticia.slug}`} class="hover:text-navy">{noticia.titulo}</a>
    </h3>
    {noticia.resumo && <p class="text-muted text-[.92rem] line-clamp-3">{noticia.resumo}</p>}
    <a href={`/noticias/${noticia.slug}`} class="mt-auto font-display font-bold text-[.88rem] text-red">Ler mais →</a>
  </div>
</article>
