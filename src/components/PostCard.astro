---
import type { BlogPost } from '../lib/blog';
import { formatDate } from '../lib/format';

interface Props { post: BlogPost; }
const { post } = Astro.props;
const data = formatDate(post.date);
---
<article class="group flex flex-col bg-surface border border-line rounded-card overflow-hidden shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl hover:border-navy/40">
  <a href={post.link} target="_blank" rel="noopener" class="relative block aspect-[16/10] overflow-hidden">
    {post.image ? (
      <img src={post.image} alt={post.title} loading="lazy" width="600" height="375"
           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <div class="w-full h-full grid place-items-center text-center p-4 text-white/85 font-display font-bold bg-gradient-to-br from-navy to-red">
        {post.title.slice(0, 40)}
      </div>
    )}
    {data && (
      <span class="absolute top-3 left-3 font-display text-[.68rem] font-bold tracking-wide uppercase text-navy bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full shadow-sm">{data}</span>
    )}
  </a>
  <div class="p-5 flex flex-col gap-2 flex-1">
    <h3 class="font-display font-bold text-[1.08rem] leading-tight line-clamp-2">
      <a href={post.link} target="_blank" rel="noopener" class="transition-colors hover:text-navy">{post.title}</a>
    </h3>
    {post.excerpt && <p class="text-muted text-[.92rem] line-clamp-3">{post.excerpt}</p>}
    <a href={post.link} target="_blank" rel="noopener"
       class="mt-auto inline-flex items-center gap-1 font-display font-bold text-[.88rem] text-red">
      Ler no blog
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  </div>
</article>
