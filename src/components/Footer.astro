---
import { Icon } from 'astro-icon/components';
import { getRedesSociais } from '../models/redesSociais';
import { getMenuMetaByPosition } from '../models/menu';

const [redesSociais, ...footerColumns] = await Promise.all([
  getRedesSociais(),
  getMenuMetaByPosition('bottom-1'),
  getMenuMetaByPosition('bottom-2'),
  getMenuMetaByPosition('bottom-3'),
]);

const columns = footerColumns.filter((col): col is NonNullable<typeof col> => col !== null);
---

<footer class="footer-wrapper">
  <div class="footer-angle"></div>

  <div class="footer-body">
    <div class="footer-container">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img
            src="/logo.png"
            alt="Condor"
            class="footer-logo"
            width="180"
            height="48"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline">
          Condor. <span class="tagline-accent">Tem sempre muito mais</span>
        </p>
        <div class="footer-social">
          {redesSociais.map((rede) => (
            <a
              href={rede.url}
              class="social-link"
              aria-label={rede.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={`fa6-brands:${rede.icon.replace('_', '-')}`} class="social-icon" />
            </a>
          ))}
        </div>
      </div>

      <!-- Nav Columns -->
      {columns.length > 0 && (
        <nav class="footer-nav" aria-label="Footer navigation">
          {columns.map((column) => (
            <div class="footer-nav-col">
              <h3 class="footer-nav-title">{column.name}</h3>
              <ul class="footer-nav-list">
                {column.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} Condor. Todos los derechos reservados.
        </p>
        <div class="footer-legal">
          <a href="#">Términos y Condiciones</a>
          <span class="legal-separator" aria-hidden="true"></span>
          <a href="#">Política de Privacidad</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Sans:wght@400;500&display=swap');

  /* === Tokens === */
  .footer-wrapper {
    --condor-blue: #003B8E;
    --condor-blue-deep: #002456;
    --condor-red: #E31937;
    --condor-red-glow: #FF2D4B;
    --condor-slate: #8A9BB5;
    --condor-light: #C8D5E8;
    --condor-surface: #F0F4FA;

    position: relative;
    font-family: 'DM Sans', system-ui, sans-serif;
    overflow: hidden;
  }

  /* === Diagonal Cut (echoing logo arrow) === */
  .footer-angle {
    height: 60px;
    background: #001A3D;
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* === Main Body === */
  .footer-body {
    background:#001A3D;
    position: relative;
    margin-top: -1px;
  }

  .footer-body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse 600px 400px at 10% 20%, rgba(0, 59, 142, 0.3), transparent),
      radial-gradient(ellipse 400px 300px at 90% 80%, rgba(227, 25, 55, 0.08), transparent);
    pointer-events: none;
  }

  /* Subtle grid texture */
  .footer-body::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  /* === Container === */
  .footer-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 1.2fr 2fr;
      gap: 3rem;
      padding: 3.5rem 2rem 3rem;
    }
  }

  /* === Brand === */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo-link {
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .footer-logo-link:hover {
    opacity: 0.85;
  }

  .footer-logo {
    width: 160px;
    height: auto;
  }

  @media (min-width: 768px) {
    .footer-logo {
      width: 180px;
    }
  }

  .footer-tagline {
    color: var(--condor-slate);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 280px;
  }

  .tagline-accent {
    color: var(--condor-red);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* === Social === */
  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--condor-slate);
    transition: all 0.25s ease;
  }

  .social-link:hover {
    background: var(--condor-red);
    border-color: var(--condor-red);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(227, 25, 55, 0.35);
  }

  .social-icon {
    width: 16px;
    height: 16px;
  }

  /* === Navigation === */
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-nav {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .footer-nav-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--condor-light);
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .footer-nav-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 2px;
    background: var(--condor-red);
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav-list a {
    color: var(--condor-slate);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
    position: relative;
  }

  .footer-nav-list a::before {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--condor-red);
    transition: width 0.3s ease;
  }

  .footer-nav-list a:hover {
    color: white;
  }

  .footer-nav-list a:hover::before {
    width: 100%;
  }

  /* === Bottom Bar === */
  .footer-bottom {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      text-align: left;
    }
  }

  .footer-copy {
    color: rgba(138, 155, 181, 0.6);
    font-size: 0.78rem;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-legal a {
    color: rgba(138, 155, 181, 0.6);
    text-decoration: none;
    font-size: 0.78rem;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--condor-light);
  }

  .legal-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(138, 155, 181, 0.3);
  }
</style>
