<footer class="footer-wrapper">
  <div class="footer-angle"></div>

  <div class="footer-body">
    <div class="footer-container">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img
            src="/logo.png"
            alt="Condor"
            class="footer-logo"
            width="180"
            height="48"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline">
          Soluciones logísticas que conectan destinos.
          <span class="tagline-accent">Sin límites.</span>
        </p>
        <div class="footer-social">
          <a href="#" class="social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav Columns -->
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav-col">
          <h3 class="footer-nav-title">Servicios</h3>
          <ul class="footer-nav-list">
            <li><a href="#">Transporte Nacional</a></li>
            <li><a href="#">Logística Internacional</a></li>
            <li><a href="#">Almacenamiento</a></li>
            <li><a href="#">Distribución</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <h3 class="footer-nav-title">Empresa</h3>
          <ul class="footer-nav-list">
            <li><a href="#">Sobre Nosotros</a></li>
            <li><a href="#">Trabaja con Nosotros</a></li>
            <li><a href="#">Novedades</a></li>
            <li><a href="#">Contacto</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <h3 class="footer-nav-title">Contacto</h3>
          <ul class="footer-nav-list footer-contact">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact-icon">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              Buenos Aires, Argentina
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact-icon">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
              +54 11 1234-5678
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact-icon">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              info@condor.com.ar
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} Condor. Todos los derechos reservados.
        </p>
        <div class="footer-legal">
          <a href="#">Términos y Condiciones</a>
          <span class="legal-separator" aria-hidden="true"></span>
          <a href="#">Política de Privacidad</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Sans:wght@400;500&display=swap');

  /* === Tokens === */
  .footer-wrapper {
    --condor-blue: #003B8E;
    --condor-blue-deep: #002456;
    --condor-red: #E31937;
    --condor-red-glow: #FF2D4B;
    --condor-slate: #8A9BB5;
    --condor-light: #C8D5E8;
    --condor-surface: #F0F4FA;

    position: relative;
    font-family: 'DM Sans', system-ui, sans-serif;
    overflow: hidden;
  }

  /* === Diagonal Cut (echoing logo arrow) === */
  .footer-angle {
    height: 60px;
    background: #001A3D;
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* === Main Body === */
  .footer-body {
    background:#001A3D;
    position: relative;
    margin-top: -1px;
  }

  .footer-body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse 600px 400px at 10% 20%, rgba(0, 59, 142, 0.3), transparent),
      radial-gradient(ellipse 400px 300px at 90% 80%, rgba(227, 25, 55, 0.08), transparent);
    pointer-events: none;
  }

  /* Subtle grid texture */
  .footer-body::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  /* === Container === */
  .footer-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 1.2fr 2fr;
      gap: 3rem;
      padding: 3.5rem 2rem 3rem;
    }
  }

  /* === Brand === */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo-link {
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .footer-logo-link:hover {
    opacity: 0.85;
  }

  .footer-logo {
    width: 160px;
    height: auto;
  }

  @media (min-width: 768px) {
    .footer-logo {
      width: 180px;
    }
  }

  .footer-tagline {
    color: var(--condor-slate);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 280px;
  }

  .tagline-accent {
    color: var(--condor-red);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* === Social === */
  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--condor-slate);
    transition: all 0.25s ease;
  }

  .social-link:hover {
    background: var(--condor-red);
    border-color: var(--condor-red);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(227, 25, 55, 0.35);
  }

  .social-icon {
    width: 16px;
    height: 16px;
  }

  /* === Navigation === */
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-nav {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .footer-nav-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--condor-light);
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .footer-nav-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 2px;
    background: var(--condor-red);
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav-list a {
    color: var(--condor-slate);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
    position: relative;
  }

  .footer-nav-list a::before {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--condor-red);
    transition: width 0.3s ease;
  }

  .footer-nav-list a:hover {
    color: white;
  }

  .footer-nav-list a:hover::before {
    width: 100%;
  }

  /* === Contact items === */
  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--condor-slate);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .contact-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--condor-red);
  }

  /* === Bottom Bar === */
  .footer-bottom {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      text-align: left;
    }
  }

  .footer-copy {
    color: rgba(138, 155, 181, 0.6);
    font-size: 0.78rem;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-legal a {
    color: rgba(138, 155, 181, 0.6);
    text-decoration: none;
    font-size: 0.78rem;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--condor-light);
  }

  .legal-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(138, 155, 181, 0.3);
  }
</style>
