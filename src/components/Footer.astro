---
import { getMenu, getRedesSociais } from '../lib/directus';
import SocialIcon from './SocialIcon.astro';

const [inst, serv, redes] = await Promise.all([
  getMenu('bottom-1'),
  getMenu('bottom-2'),
  getRedesSociais(),
]);
const year = 2026; // ponytail: build estático; ano fixo — atualizar no rebuild anual.
---

<footer class="bg-navy text-white/80">
  <div class="mx-auto max-w-[1200px] px-6 grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-display font-extrabold text-2xl text-white">
        <span class="grid place-items-center w-[34px] h-[34px] rounded-[9px] bg-white/15">C</span>
        Condor
      </a>
      <p class="mt-4 max-w-[32ch]">A rede de supermercados mais amada dos paranaenses. 50 anos ao seu lado.</p>
      <div class="flex gap-2 mt-5">
        {redes.map((r) => (
          <a href={r.url} target="_blank" rel="noopener" aria-label={r.label}
             class="grid place-items-center w-9 h-9 rounded-[9px] bg-white/10 hover:bg-red text-white [&>svg]:w-4 [&>svg]:h-4">
            <SocialIcon icon={r.icon} />
          </a>
        ))}
      </div>
    </div>

    <div>
      <h4 class="text-white text-[.78rem] tracking-[.12em] uppercase mb-4">Institucional</h4>
      <ul class="flex flex-col gap-2.5">
        {inst.map((i) => <li><a href={i.url ?? '#'} class="hover:text-white">{i.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h4 class="text-white text-[.78rem] tracking-[.12em] uppercase mb-4">Serviços</h4>
      <ul class="flex flex-col gap-2.5">
        {serv.map((i) => (
          <li><a href={i.url ?? '#'} target={i.target ?? '_self'} rel="noopener" class="hover:text-white">{i.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="text-white text-[.78rem] tracking-[.12em] uppercase mb-4">Atendimento</h4>
      <ul class="flex flex-col gap-2.5">
        <li><a href="tel:08004116655" class="hover:text-white">📞 0800 41 6655</a></li>
        <li><a href="/nossas-lojas" class="hover:text-white">Nossas Lojas</a></li>
        <li><a href="/politica-de-privacidade" class="hover:text-white">Política de Privacidade</a></li>
        <li><button type="button" onclick="window.condorConsent?.open()" class="hover:text-white text-left">Preferências de cookies</button></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto max-w-[1200px] px-6 py-5 flex flex-wrap justify-between gap-2 text-sm">
      <span>© {year} Rede Condor de Supermercados</span>
      <span>Curitiba · Paraná · Brasil</span>
    </div>
  </div>
</footer>
